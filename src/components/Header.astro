---
import Menu from '../assets/icons/menu.svg';
---

<header class="bg-blue-500 dark:bg-blue-700 text-white p-4 shadow-md transition-colors duration-300 [.high-contrast_&]:bg-black [.high-contrast_&]:border-b [.high-contrast_&]:border-white">
  <div class="container mx-auto flex justify-between items-center pl-4 pr-4">
    <div class="flex items-center">
      <div class="relative group">
        <button id="menu-toggle" class="focus:outline-none focus:ring-2 focus:ring-white focus:ring-offset-2 focus:ring-offset-blue-500 rounded mr-4 [.high-contrast_&]:focus:ring-yellow-300 [.high-contrast_&]:focus:ring-offset-black" aria-label="Toggle menu" aria-expanded="false" aria-controls="menu" data-testid="menu-toggle">
          <Menu class="h-6 w-6" aria-hidden="true" />
        </button>
        <nav id="menu" aria-label="Main" class="hidden absolute left-0 mt-2 w-48 bg-white dark:bg-slate-800 text-slate-800 dark:text-white rounded shadow-lg z-10 transition-colors duration-300 [.high-contrast_&]:bg-black [.high-contrast_&]:text-white [.high-contrast_&]:border [.high-contrast_&]:border-white">
          <ul class="py-1">
            <li><a href="/" class="block px-4 py-2 hover:bg-slate-100 dark:hover:bg-slate-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-inset [.high-contrast_&]:hover:bg-white [.high-contrast_&]:hover:text-black [.high-contrast_&]:focus:ring-yellow-300" data-testid="nav-home">Home</a></li>
            <li><a href="/about" class="block px-4 py-2 hover:bg-slate-100 dark:hover:bg-slate-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-inset [.high-contrast_&]:hover:bg-white [.high-contrast_&]:hover:text-black [.high-contrast_&]:focus:ring-yellow-300" data-testid="nav-about">About</a></li>
          </ul>
        </nav>
      </div>
      <div class="text-xl font-bold"><a href="/" class="hover:underline">Tailspin Toys</a></div>
    </div>
    <button
      id="contrast-toggle"
      type="button"
      class="rounded-lg border border-white/40 bg-slate-900/80 px-3 py-2 text-sm font-semibold text-white transition-colors hover:bg-slate-900 focus:outline-none focus:ring-2 focus:ring-white focus:ring-offset-2 focus:ring-offset-blue-500 [.high-contrast_&]:border-white [.high-contrast_&]:bg-black [.high-contrast_&]:focus:ring-yellow-300 [.high-contrast_&]:focus:ring-offset-black [.high-contrast_&]:hover:bg-white [.high-contrast_&]:hover:text-black"
      aria-pressed="false"
      aria-label="Enable high-contrast mode"
      data-testid="high-contrast-toggle"
    >
      <span data-contrast-label aria-live="polite" aria-atomic="true">High contrast: off</span>
    </button>
  </div>
</header>

<script>
  const menuToggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('menu');
  const contrastToggle = document.querySelector<HTMLButtonElement>('#contrast-toggle');
  const contrastLabel = contrastToggle?.querySelector('[data-contrast-label]');
  const storageKey = 'tailspin-high-contrast';

  const setHighContrastState = (enabled: boolean): void => {
    document.documentElement.classList.toggle('high-contrast', enabled);
    if (contrastToggle) {
      contrastToggle.setAttribute('aria-pressed', String(enabled));
      contrastToggle.setAttribute(
        'aria-label',
        enabled ? 'Disable high-contrast mode' : 'Enable high-contrast mode',
      );
    }
    if (contrastLabel) {
      contrastLabel.textContent = enabled ? 'High contrast: on' : 'High contrast: off';
    }
  };

  if (contrastToggle) {
    setHighContrastState(document.documentElement.classList.contains('high-contrast'));

    contrastToggle.addEventListener('click', () => {
      const enabled = !document.documentElement.classList.contains('high-contrast');
      setHighContrastState(enabled);
      try {
        window.localStorage.setItem(storageKey, String(enabled));
      } catch {
        // localStorage access may be blocked in private contexts.
      }
    });
  }

  if (menuToggle && menu) {
    menuToggle.addEventListener('click', () => {
      menu.classList.toggle('hidden');
      const isExpanded = !menu.classList.contains('hidden');
      menuToggle.setAttribute('aria-expanded', String(isExpanded));
      if (isExpanded) {
        const firstLink = menu.querySelector('a');
        if (firstLink) firstLink.focus();
      }
    });

    document.addEventListener('click', (event) => {
      const target = event.target;
      const isClickInside = target instanceof Node && (menuToggle.contains(target) || menu.contains(target));
      if (!isClickInside && !menu.classList.contains('hidden')) {
        menu.classList.add('hidden');
        menuToggle.setAttribute('aria-expanded', 'false');
      }
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !menu.classList.contains('hidden')) {
        menu.classList.add('hidden');
        menuToggle.setAttribute('aria-expanded', 'false');
        menuToggle.focus();
      }
    });
  }
</script>