---
// Homepage catalog with accessible, URL-backed category and publisher filtering.

import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import { getDatabase } from '../lib/db';
import { getAllGames } from '../lib/games';
import { getAllPublishers } from '../lib/publishers';

export const prerender = true;

const db = getDatabase();
const [games, publishers] = await Promise.all([
  getAllGames(db),
  getAllPublishers(db),
]);
const categories = Array.from(
  new Map(
    games.flatMap((game) =>
      game.category === null
        ? []
        : [[game.category.id, game.category] as const],
    ),
  ).values(),
).sort((first, second) => first.name.localeCompare(second.name));
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <section aria-labelledby="featured-games-heading">
      <div class="mb-6 flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">
        <h2 id="featured-games-heading" class="text-2xl font-medium text-slate-100">Featured Games</h2>
        {games.length > 0 && (
          <p
            id="filter-status"
            class="text-sm text-slate-300"
            role="status"
            aria-live="polite"
            data-testid="filter-status"
          >
            Showing all {games.length} games.
          </p>
        )}
      </div>

      {games.length > 0 && (
        <form
          class="mb-8 rounded-xl border border-slate-700 bg-slate-800/60 p-5 shadow-lg"
          id="game-filters"
          data-testid="game-filters"
        >
          <div class="grid gap-6 lg:grid-cols-[1fr_18rem_auto] lg:items-end">
            <fieldset>
              <legend class="mb-3 text-sm font-semibold text-slate-100">Categories</legend>
              <div class="flex flex-wrap gap-3">
                {categories.map((category) => (
                  <label
                    class="flex cursor-pointer items-center gap-2 rounded-lg border border-slate-600 bg-slate-900/60 px-3 py-2 text-sm text-slate-200 transition-colors hover:border-blue-500/70 hover:bg-slate-800"
                  >
                    <input
                      type="checkbox"
                      name="category"
                      value={category.id}
                      class="h-4 w-4 rounded border-slate-500 bg-slate-800 text-blue-600 focus:outline-none focus:ring-2 focus:ring-blue-500"
                      aria-controls="games-grid filter-empty-state"
                      data-testid={`category-filter-${category.id}`}
                    />
                    <span>{category.name}</span>
                  </label>
                ))}
              </div>
            </fieldset>

            <div>
              <label for="publisher-filter" class="mb-2 block text-sm font-semibold text-slate-100">
                Publisher
              </label>
              <select
                id="publisher-filter"
                name="publisher"
                class="w-full rounded-lg border border-slate-600 bg-slate-900 px-3 py-2.5 text-slate-100 focus:outline-none focus:ring-2 focus:ring-blue-500"
                aria-controls="games-grid filter-empty-state"
                data-testid="publisher-filter"
              >
                <option value="">All publishers</option>
                {publishers.map((publisher) => (
                  <option value={publisher.id}>{publisher.name}</option>
                ))}
              </select>
            </div>

            <button
              type="button"
              id="clear-filters"
              class="rounded-lg border border-slate-600 bg-slate-700 px-4 py-2.5 font-medium text-slate-100 transition-colors hover:bg-slate-600 focus:outline-none focus:ring-2 focus:ring-blue-500 disabled:cursor-not-allowed disabled:opacity-50"
              aria-controls="games-grid filter-empty-state"
              data-testid="clear-filters"
              disabled
            >
              Clear filters
            </button>
          </div>
        </form>
      )}

      {games.length === 0 ? (
        <EmptyState text="No games available at the moment." />
      ) : (
        <>
          <div
            id="games-grid"
            class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3"
            data-testid="games-grid"
          >
            {games.map((game) => <GameCard game={game} />)}
          </div>
          <div id="filter-empty-state" data-testid="filter-empty-state" hidden>
            <EmptyState text="No games match the selected filters." />
          </div>
        </>
      )}
    </section>
  </div>
</Layout>

<script>
  const filterForm = document.querySelector<HTMLFormElement>('#game-filters');

  if (filterForm) {
    const categoryInputs = Array.from(
      filterForm.querySelectorAll<HTMLInputElement>('input[name="category"]'),
    );
    const publisherSelect = filterForm.querySelector<HTMLSelectElement>('#publisher-filter');
    const clearButton = filterForm.querySelector<HTMLButtonElement>('#clear-filters');
    const gamesGrid = document.querySelector<HTMLElement>('#games-grid');
    const filterEmptyState = document.querySelector<HTMLElement>('#filter-empty-state');
    const filterStatus = document.querySelector<HTMLElement>('#filter-status');
    const gameCards = Array.from(
      document.querySelectorAll<HTMLElement>('[data-testid="game-card"]'),
    );

    if (publisherSelect && clearButton && gamesGrid && filterEmptyState && filterStatus) {
      const updateFilters = (updateUrl: boolean): void => {
        const selectedCategoryIds = categoryInputs
          .filter((input) => input.checked)
          .map((input) => input.value);
        const selectedCategoryIdSet = new Set(selectedCategoryIds);
        const publisherId = publisherSelect.value;
        let visibleCount = 0;

        for (const card of gameCards) {
          const matchesCategory =
            selectedCategoryIdSet.size === 0 ||
            (card.dataset.categoryId !== undefined &&
              selectedCategoryIdSet.has(card.dataset.categoryId));
          const matchesPublisher =
            publisherId === '' || card.dataset.publisherId === publisherId;
          const isVisible = matchesCategory && matchesPublisher;

          card.hidden = !isVisible;
          if (isVisible) {
            visibleCount += 1;
          }
        }

        const hasActiveFilters = selectedCategoryIds.length > 0 || publisherId !== '';
        gamesGrid.hidden = visibleCount === 0;
        filterEmptyState.hidden = visibleCount !== 0;
        clearButton.disabled = !hasActiveFilters;
        filterStatus.textContent = hasActiveFilters
          ? `Showing ${visibleCount} of ${gameCards.length} games.`
          : `Showing all ${gameCards.length} games.`;

        if (updateUrl) {
          const url = new URL(window.location.href);
          url.searchParams.delete('category');
          url.searchParams.delete('publisher');

          for (const categoryId of selectedCategoryIds) {
            url.searchParams.append('category', categoryId);
          }
          if (publisherId !== '') {
            url.searchParams.set('publisher', publisherId);
          }

          window.history.replaceState({}, '', `${url.pathname}${url.search}${url.hash}`);
        }
      };

      const params = new URLSearchParams(window.location.search);
      const requestedCategoryIds = new Set(params.getAll('category'));
      for (const input of categoryInputs) {
        input.checked = requestedCategoryIds.has(input.value);
      }

      const requestedPublisherId = params.get('publisher');
      if (
        requestedPublisherId !== null &&
        Array.from(publisherSelect.options).some(
          (option) => option.value === requestedPublisherId,
        )
      ) {
        publisherSelect.value = requestedPublisherId;
      }

      filterForm.addEventListener('change', () => updateFilters(true));
      clearButton.addEventListener('click', () => {
        filterForm.reset();
        updateFilters(true);
      });

      updateFilters(true);
    }
  }
</script>
